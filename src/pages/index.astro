---
import About from "@/components/home/About.astro"
import Contact from "@/components/home/Contact.astro"
import Hero from "@/components/home/Hero.astro"
import Showcase from "@/components/home/Showcase.astro"
import { PROFILE } from "@/constants/profile"
import RootLayout from "@/layouts/RootLayout.astro"
import { getPersonSchema } from "@/lib/structured-data"
import type { ProfilePage, WithContext } from "schema-dts"

const pageTitle = `${PROFILE.name} - ${PROFILE.title}`
const pageDescription = `${PROFILE.name} is a ${PROFILE.title} from ${PROFILE.country} who designs and builds web products end to end, using AI agents to ship faster without cutting corners.`

const jsonLd: WithContext<ProfilePage> = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.toString(),
  mainEntity: getPersonSchema(Astro.site),
}
---

<RootLayout title={pageTitle} description={pageDescription}>
  <main id="main" class="flex flex-col gap-y-24 pb-24 md:gap-y-32 md:pb-32">
    <Hero />
    <Showcase />
    <About />
    <Contact />
  </main>
  <script
    slot="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
</RootLayout>
