---
import ContactButton from "@/components/ContactButton.astro"
import Iso from "@/components/Iso.astro"
import ProjectStoryPlaceholder from "@/components/projects/ProjectStoryPlaceholder.astro"
import { projectContentComponents } from "@/components/projects/project-content-components"
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbSeparator,
} from "@/components/ui/breadcrumb"
import { badgeVariants } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { Typography } from "@/components/ui/typography"
import { PROFILE } from "@/constants/profile"
import RootLayout from "@/layouts/RootLayout.astro"
import {
  formatProjectPeriod,
  getProjectHref,
  getProjects,
  hasProjectStory,
  PROJECT_STATUS_LABELS,
  type Project,
} from "@/lib/projects"
import { getBreadcrumbSchema, getPersonSchema } from "@/lib/structured-data"
import { cn } from "@/lib/utils"
import type { GetStaticPaths } from "astro"
import { getImage, Image } from "astro:assets"
import { render } from "astro:content"
import { Archive, ArrowUpRight } from "lucide-react"
import type { CreativeWork, WithContext } from "schema-dts"

export const getStaticPaths = (async () => {
  const projects = await getProjects()
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}) satisfies GetStaticPaths

interface Props {
  project: Project
}
const { project } = Astro.props
const { Content } = await render(project)
const hasStory = hasProjectStory(project)
const {
  name,
  category,
  summary,
  status,
  role,
  stack,
  url,
  archiveUrl,
  icon,
  cover,
  gallery,
  startDate,
} = project.data
const period = formatProjectPeriod(project.data)
const coverAlt = `Screenshot of ${name}`

const details = [
  { label: "Type", value: category },
  { label: "Status", value: PROJECT_STATUS_LABELS[status] },
  { label: "Period", value: period },
  { label: "Role", value: role },
].filter((detail) => detail.value)

const pageTitle = `${name} - ${PROFILE.name}`
const pagePath = getProjectHref(project)

const coverImage = await getImage({ src: cover, format: "jpg", width: 1200 })
const jsonLd: WithContext<CreativeWork> = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name,
  description: summary,
  genre: category,
  url: new URL(pagePath, Astro.site).href,
  image: new URL(coverImage.src, Astro.site).href,
  creator: getPersonSchema(Astro.site),
  ...(startDate && { dateCreated: startDate.toISOString().slice(0, 10) }),
  ...(stack.length > 0 && { keywords: stack.join(", ") }),
  ...(archiveUrl && { archivedAt: archiveUrl }),
}
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects/" },
  { name, path: pagePath },
]
const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs, Astro.site)
---

<RootLayout
  title={pageTitle}
  description={summary}
  image={{ src: cover, alt: coverAlt }}
  noindex={!hasStory}
>
  <main id="main" class="shell mt-20 space-y-12 py-24 md:py-32">
    <Breadcrumb>
      <BreadcrumbList className="justify-center lg:justify-start">
        {
          breadcrumbs.map(({ name: crumb, path }, index) =>
            index < breadcrumbs.length - 1 ? (
              <>
                <BreadcrumbItem>
                  <BreadcrumbLink href={path}>{crumb}</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbSeparator />
              </>
            ) : (
              <BreadcrumbItem>
                <span aria-current="page" class="text-foreground">
                  {crumb}
                </span>
              </BreadcrumbItem>
            ),
          )
        }
      </BreadcrumbList>
    </Breadcrumb>
    <article class="space-y-12" aria-labelledby="project-title">
      <header class="space-y-6 text-center lg:text-left">
        <Typography
          variant="h1"
          id="project-title"
          className="flex items-center justify-center gap-[0.25em] lg:justify-start"
        >
          {
            icon && (
              <span class="flex size-[0.9em] shrink-0 items-center justify-center border p-[0.15em]">
                <Image
                  src={icon}
                  alt=""
                  loading="eager"
                  class="size-full object-contain"
                />
              </span>
            )
          }
          <span>{name}</span>
        </Typography>
        <Typography variant="p" className="mx-auto text-pretty lg:mx-0">
          {summary}
        </Typography>
        {
          ((url && status === "live") || archiveUrl) && (
            <div class="flex flex-wrap justify-center gap-2 lg:justify-start">
              {url && status === "live" && (
                <a
                  href={url}
                  target="_blank"
                  rel="noreferrer"
                  class={buttonVariants()}
                >
                  Visit {name}
                  <span class="sr-only">(opens in a new tab)</span>
                  <ArrowUpRight className="size-5" />
                </a>
              )}
              {archiveUrl && (
                <a
                  href={archiveUrl}
                  target="_blank"
                  rel="noreferrer"
                  class={buttonVariants({ variant: "outline" })}
                >
                  <Archive className="size-5" />
                  View archived version
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )}
            </div>
          )
        }
      </header>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        class="w-full border"
        loading="eager"
        fetchpriority="high"
      />
      <div class="max-w-prose space-y-12 text-lg md:text-xl">
        {
          details.length > 0 && (
            <dl class="flex flex-wrap gap-2">
              {details.map(({ label, value }) => (
                <div
                  class={cn(
                    badgeVariants({ variant: "outline" }),
                    "items-stretch p-0 font-mono",
                  )}
                >
                  <dt class="text-muted-foreground flex items-center border-r px-2 py-1 uppercase">
                    {label}
                  </dt>
                  <dd class="flex items-center px-2 py-1 text-sm">{value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div class="[&>:first-child]:mt-0">
          {
            hasStory ? (
              <Content components={projectContentComponents} />
            ) : (
              <ProjectStoryPlaceholder name={name} />
            )
          }
        </div>
        {
          stack.length > 0 && (
            <dl class="text-muted-foreground font-mono text-sm">
              <dt class="mr-2 inline text-xs uppercase">Built with</dt>
              <dd class="text-foreground inline">
                <ul role="list" class="inline">
                  {stack.map((tool, index) => (
                    <li class="inline">
                      {index > 0 && <span aria-hidden="true"> · </span>}
                      {tool}
                    </li>
                  ))}
                </ul>
              </dd>
            </dl>
          )
        }
      </div>
      {
        gallery.length > 0 && (
          <section aria-labelledby="gallery-title" class="space-y-12">
            <Typography
              variant="h2"
              id="gallery-title"
              className="text-center lg:text-left"
            >
              Project <span class="text-primary">Gallery</span>
            </Typography>
            <ul role="list" class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {gallery.map(({ image, alt, caption }) => (
                <li>
                  <figure class="space-y-2">
                    <Image
                      src={image}
                      alt={alt}
                      widths={[640, 1024]}
                      sizes="(min-width: 768px) 50vw, 100vw"
                      class="w-full border"
                    />
                    {caption && (
                      <figcaption class="text-muted-foreground font-mono text-sm">
                        {caption}
                      </figcaption>
                    )}
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
    <section
      aria-labelledby="project-cta-title"
      class="relative flex flex-col items-center gap-6 overflow-hidden border px-10 py-10 text-center [box-shadow:0_-20px_80px_-20px_#ffffff1f_inset] sm:items-start sm:pr-56 sm:text-left md:px-12 md:py-12"
      data-motion-graphic
    >
      <hgroup class="space-y-2">
        <Typography variant="h2" id="project-cta-title">
          Have a Project <span class="text-primary">Like This</span> in Mind?
        </Typography>
        <Typography variant="p" className="mx-auto sm:mx-0">
          Let's talk about how I can help.
        </Typography>
      </hgroup>
      <ContactButton />
      <Iso
        class="animate-draw stroke-primary absolute -right-8 -bottom-16 hidden w-60 [stroke-dasharray:1000] motion-reduce:animate-none sm:block"
      />
    </section>
    <script>
      import "@/lib/pause-offscreen"
    </script>
  </main>
  <script
    slot="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <script
    slot="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
</RootLayout>
