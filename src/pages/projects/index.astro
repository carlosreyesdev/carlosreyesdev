---
import ProjectStack from "@/components/projects/ProjectStack.astro"
import ProjectStatusBadge from "@/components/projects/ProjectStatusBadge.astro"
import { Typography } from "@/components/ui/typography"
import { PROFILE } from "@/constants/profile"
import RootLayout from "@/layouts/RootLayout.astro"
import {
  formatProjectPeriod,
  getProjectHref,
  getProjects,
} from "@/lib/projects"
import { getBreadcrumbSchema, getPersonSchema } from "@/lib/structured-data"
import { Image } from "astro:assets"
import { ArrowRight } from "lucide-react"
import type { CollectionPage, WithContext } from "schema-dts"

const projects = await getProjects()

const pageTitle = `Projects - ${PROFILE.name}`
const pageDescription = `Every project I've worked on as a ${PROFILE.title}, including the ones that are no longer online.`

const jsonLd: WithContext<CollectionPage> = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.toString(),
  author: getPersonSchema(Astro.site),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.data.name,
      url: new URL(getProjectHref(project), Astro.site).href,
    })),
  },
}
const breadcrumbJsonLd = getBreadcrumbSchema(
  [
    { name: "Home", path: "/" },
    { name: "Projects", path: "/projects" },
  ],
  Astro.site,
)
---

<RootLayout title={pageTitle} description={pageDescription}>
  <main class="shell mt-20 space-y-8 py-20">
    <hgroup class="mx-auto max-w-3xl space-y-4 text-center">
      <Typography variant="h1">
        All <span class="text-primary">Projects</span>
      </Typography>
      <Typography variant="p" className="text-balance">
        Everything I've built, including the projects that were discontinued or
        replaced along the way.
      </Typography>
    </hgroup>
    <ul
      role="list"
      class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        projects.map((project) => {
          const { name, category, summary, cover, status, stack } = project.data
          const period = formatProjectPeriod(project.data)
          return (
            <li>
              <article class="group bg-background has-[a:focus-visible]:ring-ring/50 relative flex h-full flex-col border [box-shadow:0_-20px_80px_-20px_#ffffff1f_inset] has-[a:focus-visible]:ring-[3px]">
                <div class="relative aspect-video overflow-hidden border-b">
                  <Image
                    src={cover}
                    alt=""
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    class="size-full object-cover object-top [transition:object-position_10s_linear] group-hover:object-[center_bottom]"
                  />
                  <ProjectStatusBadge
                    status={status}
                    class="absolute top-4 right-4"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-y-2 px-8 py-7">
                  <p class="text-muted-foreground font-mono text-sm uppercase">
                    {category}
                    {period && ` · ${period}`}
                  </p>
                  <Typography variant="h3" as="h2">
                    <a
                      href={getProjectHref(project)}
                      class="outline-none after:absolute after:inset-0"
                    >
                      {name}
                    </a>
                  </Typography>
                  <Typography variant="p" className="max-w-lg flex-1">
                    {summary}
                  </Typography>
                  <ProjectStack stack={stack} class="mt-2" />
                  <p
                    aria-hidden="true"
                    class="text-primary mt-2 font-medium underline-offset-4 group-hover:underline md:text-xl"
                  >
                    View project
                    <ArrowRight className="ml-1 inline-block size-5" />
                  </p>
                </div>
              </article>
            </li>
          )
        })
      }
    </ul>
  </main>
  <script
    slot="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <script
    slot="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
</RootLayout>
