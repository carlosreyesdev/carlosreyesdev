---
import ProfileCard from "@/components/links/ProfileCard.astro"
import ProfileLinksList from "@/components/links/ProfileLinksList.astro"
import { PROFILE } from "@/constants/profile"
import RootLayout from "@/layouts/RootLayout.astro"
import { getPersonSchema } from "@/lib/structured-data"
import type { WebPage, WithContext } from "schema-dts"

const pageTitle = `Links - ${PROFILE.name}`
const pageDescription = `All of ${PROFILE.name}' links in one place: GitHub, LinkedIn, Instagram, X, the Esquina del Código blog, email and WhatsApp.`

// The home page is the ProfilePage; this one is just about the same person
const jsonLd: WithContext<WebPage> = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: Astro.url.toString(),
  about: getPersonSchema(Astro.site),
}
---

<RootLayout title={pageTitle} description={pageDescription}>
  <main id="main" class="shell mt-24 max-w-2xl space-y-4 pb-4">
    <ProfileCard />
    <ProfileLinksList />
  </main>
  <script
    slot="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
</RootLayout>
