---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"

interface Props {
  src: ImageMetadata | string
  alt: string
}
const { src, alt } = Astro.props
---

{
  typeof src === "string" ? (
    <img src={src} alt={alt} class="my-8 w-full border" loading="lazy" />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={[640, 1024]}
      sizes="(min-width: 768px) 730px, 100vw"
      class="my-8 w-full border"
    />
  )
}
