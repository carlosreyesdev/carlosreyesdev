---
import { cn } from "@/lib/utils"
import { Check } from "@lucide/astro"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"input">
const { type, checked, ...props } = Astro.props
const isChecked = Boolean(checked)
---

{
  type === "checkbox" ? (
    <>
      <span
        data-task-checkbox
        data-state={isChecked ? "checked" : "unchecked"}
        aria-hidden="true"
        class={cn(
          "border-input dark:bg-input/30 -mt-1 mr-2 inline-grid size-4 shrink-0 place-content-center border indent-0 align-middle shadow-xs",
          isChecked &&
            "bg-primary text-primary-foreground border-primary dark:bg-primary",
        )}
      >
        {isChecked && <Check class="size-3.5" />}
      </span>
      <span class="sr-only">{isChecked ? "Done:" : "Pending:"}</span>
    </>
  ) : (
    <input type={type} checked={checked} {...props} />
  )
}
