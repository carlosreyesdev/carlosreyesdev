---
import { Typography } from "../ui/typography"

interface Props {
  name: string
}
const { name } = Astro.props
---

<section aria-labelledby="project-story-title" class="space-y-2">
  <p
    class="text-muted-foreground flex items-center gap-2 font-mono text-xs uppercase"
  >
    <span class="bg-primary size-1.5 motion-safe:animate-pulse"></span>
    Drafting
  </p>
  <Typography variant="h2" id="project-story-title" className="lg:text-4xl">
    The Story Is <span class="text-primary">Being Written</span>
  </Typography>
  <Typography variant="p" className="text-muted-foreground text-pretty">
    I'm putting together the full story behind {name}. Check back soon.
  </Typography>
</section>
