---
import { NAVIGATION_LINKS } from "@/constants/links"
import { isExternalHref } from "@/lib/utils"
import Logo from "./Logo.astro"
import { Menu } from "./menu"
import { NewTabHint } from "./new-tab-hint"
import SocialLinks from "./SocialLinks.astro"
import { Anchor } from "./ui/anchor"
import { buttonVariants } from "./ui/button"
---

<nav
  aria-label="Main"
  class="bg-background fixed top-0 z-50 w-full border-b py-4"
>
  <div class="shell flex items-center justify-between">
    <a href="/">
      <Logo />
      <span class="sr-only">Home</span>
    </a>
    <!-- On mobile these links live in the drawer menu instead -->
    <ul
      role="list"
      class="hidden w-full items-center justify-end gap-x-10 sm:flex"
    >
      {
        NAVIGATION_LINKS.map(({ label, href, asCTA }) => (
          <li>
            {asCTA ? (
              <a href={href} class={buttonVariants({ size: "sm" })}>
                {label}
              </a>
            ) : isExternalHref(href) ? (
              <Anchor
                href={href}
                target="_blank"
                rel="noreferrer"
                className="no-underline hover:underline"
              >
                {label}
                <NewTabHint />
              </Anchor>
            ) : (
              <Anchor href={href} className="no-underline hover:underline">
                {label}
              </Anchor>
            )}
          </li>
        ))
      }
    </ul>
    <Menu client:visible>
      <SocialLinks slot="socialLinks" />
    </Menu>
  </div>
</nav>
