---
import { cn } from "@/lib/utils"
import type { HTMLAttributes } from "astro/types"

type Props = Omit<HTMLAttributes<"ul">, "role">
const { class: className, ...props } = Astro.props
---

<ul
  role="list"
  class={cn("grid w-full auto-rows-[25rem] grid-cols-3 gap-4", className)}
  {...props}
>
  <slot />
</ul>
