---
import { NAVIGATION_LINKS } from "@/constants/links"
import { isExternalHref } from "@/lib/utils"
import { Menu as MenuIcon, X } from "@lucide/astro"
import NewTabHint from "./NewTabHint.astro"
import Anchor from "./ui/Anchor.astro"
import Button from "./ui/Button.astro"
import { buttonVariants } from "./ui/button"
---

<Button
  type="button"
  variant="ghost"
  size="icon"
  class="sm:hidden"
  data-menu-open
  aria-haspopup="dialog"
  aria-controls="mobile-menu"
>
  <MenuIcon class="size-8" />
  <span class="sr-only">Open menu</span>
</Button>

<dialog
  id="mobile-menu"
  aria-labelledby="mobile-menu-title"
  aria-describedby="mobile-menu-description"
  class="mobile-menu bg-background text-foreground fixed inset-x-0 top-auto bottom-0 m-0 max-h-[80vh] w-full max-w-none border-t p-0"
>
  <div class="relative flex flex-col gap-y-4 p-12">
    <div class="sr-only">
      <h2 id="mobile-menu-title">Navigation Menu</h2>
      <p id="mobile-menu-description">
        Browse the site or get in touch through the contact section.
      </p>
    </div>
    <Button
      type="button"
      variant="ghost"
      size="icon"
      class="absolute top-3 right-3"
      data-menu-close
    >
      <X class="size-6" />
      <span class="sr-only">Close menu</span>
    </Button>
    <nav aria-label="Main">
      <ul role="list" class="flex flex-col gap-y-4">
        {
          NAVIGATION_LINKS.map(({ label, href, asCTA }) => {
            const external = isExternalHref(href)
            return (
              <li>
                {asCTA ? (
                  <a href={href} class={buttonVariants()}>
                    {label}
                  </a>
                ) : (
                  <Anchor
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noreferrer" : undefined}
                    class="text-foreground text-lg no-underline hover:underline md:text-xl"
                  >
                    {label}
                    {external && <NewTabHint />}
                  </Anchor>
                )}
              </li>
            )
          })
        }
      </ul>
    </nav>
    <slot name="socialLinks" />
  </div>
</dialog>

<style>
  :global(body:has(dialog.mobile-menu[open])) {
    overflow: hidden;
  }

  .mobile-menu {
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform 220ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 180ms ease,
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }

  .mobile-menu[open] {
    transform: translateY(0);
    opacity: 1;
  }

  .mobile-menu::backdrop {
    background-color: rgb(0 0 0 / 0);
    transition:
      background-color 220ms ease,
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }

  .mobile-menu[open]::backdrop {
    background-color: rgb(0 0 0 / 0.5);
  }

  @starting-style {
    .mobile-menu[open] {
      transform: translateY(100%);
      opacity: 0;
    }

    .mobile-menu[open]::backdrop {
      background-color: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu::backdrop {
      transition: none;
    }
  }
</style>

<script>
  const dialog = document.getElementById("mobile-menu")
  const openBtn = document.querySelector("[data-menu-open]")
  const closeBtn = dialog?.querySelector("[data-menu-close]")

  if (dialog instanceof HTMLDialogElement && openBtn) {
    openBtn.addEventListener("click", () => dialog.showModal())
    closeBtn?.addEventListener("click", () => dialog.close())

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close()
    })

    dialog.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => dialog.close())
    })
  }
</script>
