---
import Typography from "../ui/Typography.astro"
import EvolutionGraphic from "./graphics/EvolutionGraphic.astro"

const principles = [
  {
    title: "I engineer, agents accelerate",
    description:
      "Agents write the code faster. Scope, architecture and decisions stay with me.",
  },
  {
    title: "Taste doesn't get delegated",
    description:
      "Years of obsessing over interfaces is what turns fast output into a polished product.",
  },
  {
    title: "Nothing ships unreviewed",
    description:
      "I review every change and try every screen before it reaches real users.",
  },
]
---

<section class="shell grid gap-12 lg:grid-cols-2" aria-labelledby="about">
  <div class="space-y-6 text-center lg:text-left">
    <Typography variant="h2" id="about">
      About Me: Same Engineer, <span class="text-primary">New Tools</span>
    </Typography>
    <Typography variant="lead" class="mx-auto lg:mx-0">
      Full Stack Software Engineer based in Venezuela, building products for
      founders and small teams since 2020. I started as a pixel-obsessed
      frontend dev and grew into the full stack. Today AI agents do much of the
      typing; deciding what gets built, and whether it's good enough to ship, is
      still on me.
    </Typography>
    <ol role="list" class="mx-auto max-w-prose divide-y border-y lg:mx-0">
      {
        principles.map(({ title, description }, index) => (
          <li class="flex flex-col items-center gap-2 py-4 lg:flex-row lg:items-start lg:gap-4">
            <span
              aria-hidden="true"
              class="text-primary font-mono text-lg leading-7 md:text-xl"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="space-y-1">
              <h3 class="text-lg leading-7 font-bold md:text-xl">{title}</h3>
              <Typography variant="p" class="text-muted-foreground">
                {description}
              </Typography>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <div
    class="relative mx-auto aspect-4/3 w-full max-w-2xl overflow-hidden border lg:mx-0 lg:max-w-none lg:self-start"
  >
    <EvolutionGraphic />
  </div>
</section>
