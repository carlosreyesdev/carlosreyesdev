---
import { getProjectHref, getProjects } from "@/lib/projects"
import { cn } from "@/lib/utils"
import { Image, Picture } from "astro:assets"
import { ArrowRight } from "@lucide/astro"
import ProjectStatusBadge from "../projects/ProjectStatusBadge.astro"
import BentoCard from "../ui/BentoCard.astro"
import BentoGrid from "../ui/BentoGrid.astro"
import { buttonVariants } from "../ui/button"
import Typography from "../ui/Typography.astro"

const projects = await getProjects({ featured: true })

// Splits the cards into full 3-column rows, always leading with a wide card
function getBentoSpans(count: number): number[] {
  if (count === 0) return []
  if (count === 1) return [3]
  const rest = count - 2
  const rows: number[][] = [[2, 1]]
  let fullRows = Math.floor(rest / 3)
  let pairRows = rest % 3 === 2 ? 1 : 0
  if (rest % 3 === 1) {
    if (fullRows > 0) {
      fullRows -= 1
      pairRows = 2
    } else {
      rows.push([3])
    }
  }
  for (let i = 0; i < fullRows; i++) rows.push([1, 1, 1])
  for (let i = 0; i < pairRows; i++)
    rows.push(rows.length % 2 === 1 ? [1, 2] : [2, 1])
  return rows.flat()
}

const SPAN_CLASSES: Record<number, string> = {
  1: "col-span-3 lg:col-span-1",
  2: "col-span-3 lg:col-span-2",
  3: "col-span-3",
}
const spans = getBentoSpans(projects.length)
---

<section class="shell space-y-12" aria-labelledby="showcase">
  <hgroup class="mx-auto max-w-3xl space-y-6 text-center lg:mx-0 lg:text-left">
    <Typography variant="h2" id="showcase">
      Featured <span class="text-primary">Projects</span>
    </Typography>
    <Typography variant="lead" class="mx-auto text-pretty lg:mx-0">
      Real products for real clients, from marketing sites to full platforms.
    </Typography>
  </hgroup>
  <BentoGrid>
    {
      projects.map((project, index) => {
        const { name, category, summary, icon, cover, status } = project.data
        return (
          <BentoCard
            name={name}
            eyebrow={category}
            description={summary}
            href={getProjectHref(project)}
            cta="View project"
            class={SPAN_CLASSES[spans[index]]}
          >
            {icon ? <Image slot="icon" src={icon} alt="" /> : null}
            {status !== "live" ? (
              <ProjectStatusBadge slot="badge" status={status} />
            ) : null}
            <Picture
              slot="background"
              src={cover}
              alt=""
              class="absolute inset-0 size-full object-cover object-top [transition:opacity_0.15s_linear,object-position_10s_linear] group-focus-within:opacity-25 group-focus-within:blur-sm group-hover:object-[center_bottom] group-hover:opacity-25 group-hover:blur-sm [@media(hover:none)]:opacity-25 [@media(hover:none)]:blur-sm"
            />
          </BentoCard>
        )
      })
    }
  </BentoGrid>
  <div class="flex justify-center lg:justify-start">
    <a href="/projects/" class={cn(buttonVariants({ variant: "outline" }))}>
      View all projects
      <ArrowRight aria-hidden="true" class="size-5" />
    </a>
  </div>
</section>
