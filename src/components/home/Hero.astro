---
import { PROFILE } from "@/constants/profile"
import { Image } from "astro:assets"
import ContactButton from "../ContactButton.astro"
import Iso from "../Iso.astro"
import SocialLinks from "../SocialLinks.astro"
import { Typography } from "../ui/typography"
---

<header class="mt-20 overflow-hidden pt-24 md:pt-32">
  <div class="shell grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="relative hidden lg:col-start-2 lg:row-start-1 lg:block">
      <Iso
        class="animate-draw stroke-primary absolute inset-0 [stroke-dasharray:1000]"
      />
      <Image
        src={PROFILE.photo}
        alt={`Photo of ${PROFILE.name}, ${PROFILE.title}`}
        class="relative h-full w-full mask-radial-[100%_100%] mask-radial-from-75% mask-radial-at-top-left object-cover"
        loading="eager"
      />
    </div>
    <div
      class="space-y-6 text-center lg:col-start-1 lg:row-start-1 lg:text-left"
    >
      <Typography variant="h1">
        {PROFILE.title}{" "}
        <span class="text-primary">for the AI Era</span>
      </Typography>
      <Typography variant="p" className="mx-auto lg:mx-0">
        {PROFILE.bio}
      </Typography>
      <div
        class="flex flex-wrap items-center justify-center gap-2 lg:justify-start"
      >
        <ContactButton />
        <SocialLinks />
      </div>
    </div>
  </div>
</header>
