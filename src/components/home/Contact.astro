---
import { PROFILE } from "@/constants/profile"
import { parsePhoneNumber } from "@/lib/utils"
import Iso from "../Iso.astro"
import SocialLinks from "../SocialLinks.astro"
import Anchor from "../ui/Anchor.astro"
import Separator from "../ui/Separator.astro"
import Typography from "../ui/Typography.astro"
---

<section
  class="shell grid grid-cols-1 gap-12 lg:grid-cols-2"
  aria-labelledby="contact"
>
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-y-6 text-center text-pretty lg:mx-0 lg:items-start lg:text-left"
  >
    <hgroup class="flex flex-col items-center gap-y-6 lg:items-start">
      <Typography variant="h2" id="contact"
        >Got a Web Product Idea? <span class="text-primary">Let's Ship It</span
        ></Typography
      >
      <Typography variant="lead">
        Whether you're a founder with a product to launch or a small team that
        needs to move faster, I'd love to hear about it.
      </Typography>
    </hgroup>
    <SocialLinks />
  </div>
  <div
    class="relative mx-auto h-min w-full max-w-lg text-center font-mono sm:border sm:px-8 sm:py-6 sm:text-left lg:mx-0 lg:max-w-none lg:text-lg"
  >
    <p>{PROFILE.name}</p>
    <p>{PROFILE.title}</p>
    <!-- A joke address, hidden so it isn't read out as a real one -->
    <p class="text-muted-foreground" aria-hidden="true">
      404 Not Found Lane, <br />
      CSS Grid City, JS 12345, <br />
      The Internet
    </p>
    <Separator class="my-2" />
    <address class="not-italic">
      <p>
        Email: <Anchor
          href={`mailto:${PROFILE.email}`}
          class="whitespace-nowrap">{PROFILE.email}</Anchor
        >
      </p>
      <p>
        WhatsApp: <Anchor
          href={`https://wa.me/${parsePhoneNumber(PROFILE.phone)}`}
          class="whitespace-nowrap">{PROFILE.phone}</Anchor
        >
      </p>
      <p>
        Website: <Anchor href={PROFILE.website} class="whitespace-nowrap"
          >{new URL(PROFILE.website).hostname}</Anchor
        >
      </p>
    </address>
    <Iso class="fill-primary absolute top-6 right-6 hidden w-8 sm:block" />
  </div>
</section>
